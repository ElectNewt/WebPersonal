    <PackageVersion Include="Microsoft.AspNetCore.Http.Features" Version="3.1.7" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="6.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="3.1.6" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="3.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="3.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="3.1.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="3.1.3" />
    <PackageVersion Include="Moq" Version="4.14.5" />
    <PackageVersion Include="MySql.Data" Version="8.0.20" />
    <PackageVersion Include="Netmentor.ROP" Version="1.0.13" />
    <PackageVersion Include="Netmentor.ROP.ApiExtensions" Version="1.0.13" />
